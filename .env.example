# --- Required ---
# MongoDB Atlas M0 connection string (Database > Connect > Drivers)
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/prepos?retryWrites=true&w=majority"

# openssl rand -base64 32
AUTH_SECRET=""

# Your single login. Generate the hash with: npm run hash -- 'your-strong-password'
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD_HASH_B64=""
ADMIN_NAME="Your Name"

# openssl rand -hex 32 (Vercel Cron sends it automatically as a Bearer token)
CRON_SECRET=""

APP_TIMEZONE="Asia/Kolkata"

# --- Optional: AI (the app works with none: it falls back to data/quiz-bank.json and static explanations) ---
# Free providers, tried in order with automatic failover when one is rate limited or out of daily quota.
# Gemini: a key from Google AI Studio (https://aistudio.google.com). A Gemini app/Gems subscription is NOT an API key.
GEMINI_API_KEY=""
# Leave the model blank for the default ("gemini-flash-latest", an alias that keeps working as models are retired).
GEMINI_MODEL=""
# Groq (free, OpenAI-compatible): https://console.groq.com
GROQ_API_KEY=""
# Blank = openai/gpt-oss-120b. Model ids change; list what your key can use at https://console.groq.com/docs/models
GROQ_MODEL=""
# Provider order, comma separated. The paid provider is always tried last whatever order you write.
LLM_CHAIN="gemini,groq,meta"
# PAID last resort (bills your card). Needs all three. Only used after every free provider is exhausted,
# never by background jobs, and only after you confirm in the app (Settings has a daily cap).
META_LLAMA_API_KEY=""
META_LLAMA_BASE_URL=""
META_LLAMA_MODEL=""

# --- Older single-provider setup (still works; the explicit keys above win for the same provider) ---
# gemini | anthropic | openai-compatible
LLM_PROVIDER="gemini"
LLM_API_KEY=""
# e.g. a current Gemini Flash model on the free tier, claude-haiku-4-5-20251001, or a Groq model id
LLM_MODEL=""
# Only for openai-compatible providers, e.g. https://api.groq.com/openai/v1
LLM_BASE_URL=""
# Only used by `npm run quiz-bank -- --llm`: pause between LLM calls (ms) to stay under free-tier rate limits
LLM_DELAY_MS="4000"

# --- Optional: LeetCode sync (public profile, no login) ---
# Seeds the username on first run; afterwards change it in /settings.
LEETCODE_USERNAME=""

# --- Optional: notifications outside the dashboard (cron reminders, "Send test" in /settings) ---
# Telegram: create a bot with @BotFather, message it once, then read chat.id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Recipient for email reminders and the morning digest
NOTIFY_EMAIL=""
# Email via Brevo free tier (300/day). Used instead of Resend when set. Paste the v3 API key (xkeysib-...)
# or the base64 MCP key. The sender must be verified in Brevo, and API-key IP blocking must be off
# (Brevo > Security > Authorised IPs) because Vercel has no fixed IPs. SMTP is not used.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
# Email via Resend free tier (sends from onboarding@resend.dev to your own address)
RESEND_API_KEY=""
# Public URL of the app, used for links in emails
APP_URL=""
