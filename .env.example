# --- Required ---
# MongoDB Atlas M0 connection string (Database > Connect > Drivers)
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/prepos?retryWrites=true&w=majority"

# openssl rand -base64 32
AUTH_SECRET=""

# Your single login. Generate the hash with: npm run hash -- 'your-strong-password'
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD_HASH_B64=""
ADMIN_NAME="Your Name"

# openssl rand -hex 32 (Vercel Cron sends it automatically as a Bearer token)
CRON_SECRET=""

APP_TIMEZONE="Asia/Kolkata"

# --- Optional: AI (the app works with none: it falls back to data/quiz-bank.json and static explanations) ---
# Free providers, tried in order with automatic failover when one is rate limited or out of daily quota.
# Every *_KEYS / *_API_KEY variable accepts a comma-separated list: each key is tried in turn, and one that is
# rejected, out of quota or over its token budget is skipped while the others keep working.
# NVIDIA (free, OpenAI-compatible): https://build.nvidia.com. Blank model = meta/muse-glimmer-30b.
NVIDIA_API_KEYS=""
NVIDIA_MODEL=""
# Optional candidates, tried by health and usage. Unavailable models are skipped automatically.
NVIDIA_MODELS="meta/muse-glimmer-30b,nvidia/nemotron-3-super-120b-a12b"
# OpenRouter: https://openrouter.ai/keys. Keep a ":free" model so calls cost nothing.
# Blank = nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_API_KEYS=""
OPENROUTER_MODEL=""
OPENROUTER_MODELS="openrouter/free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free"
# Lifetime tokens one key may use before it is skipped (Settings warns at 90% so you can add a new key).
LLM_KEY_TOKEN_BUDGET="100000000"
# Gemini: a key from Google AI Studio (https://aistudio.google.com). A Gemini app/Gems subscription is NOT an API key.
GEMINI_API_KEY=""
# Leave the model blank for the default ("gemini-flash-latest", an alias that keeps working as models are retired).
GEMINI_MODEL=""
GEMINI_MODELS="gemini-flash-latest"
# Groq (free, OpenAI-compatible): https://console.groq.com
GROQ_API_KEY=""
# Blank = openai/gpt-oss-120b. Model ids change; list what your key can use at https://console.groq.com/docs/models
GROQ_MODEL=""
GROQ_MODELS="openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b"
# Provider order, comma separated. Paid providers are always tried last whatever order you write.
LLM_CHAIN="nvidia,openrouter,gemini,groq,openai,meta"
# PAID last resorts (bill your card). Only used after every free provider is exhausted, never by background
# jobs or the assistant, and only after you confirm in the app (Settings has a daily cap).
# OpenAI: blank model = gpt-4o-mini. Each paid call is capped at 1024 output tokens.
OPENAI_API_KEYS=""
OPENAI_MODEL=""
# Meta Llama needs all three.
META_LLAMA_API_KEY=""
META_LLAMA_BASE_URL=""
META_LLAMA_MODEL=""
# Extra OpenAI-compatible providers (any /chat/completions API). JSON list; ids are lowercase. Treated as PAID
# unless you add "paid": false. Keys never go in the JSON: put them in LLM_EXTRA_<ID>_KEYS (id upper-cased,
# dashes as underscores). Add "jsonMode": false if the endpoint rejects response_format.
# e.g. LLM_EXTRA_PROVIDERS='[{"id":"dahl","label":"Dahl","baseUrl":"https://api.example.com/v1","model":"model-id","paid":false}]'
#      LLM_EXTRA_DAHL_KEYS="key-1,key-2"
LLM_EXTRA_PROVIDERS=""

# --- Older single-provider setup (still works; the explicit keys above win for the same provider) ---
# gemini | anthropic | openai-compatible
LLM_PROVIDER="gemini"
LLM_API_KEY=""
# e.g. a current Gemini Flash model on the free tier, claude-haiku-4-5-20251001, or a Groq model id
LLM_MODEL=""
# Only for openai-compatible providers, e.g. https://api.groq.com/openai/v1
LLM_BASE_URL=""
# Only used by `npm run quiz-bank -- --llm`: pause between LLM calls (ms) to stay under free-tier rate limits
LLM_DELAY_MS="4000"

# --- Optional: LeetCode sync (public profile, no login) ---
# Seeds the username on first run; afterwards change it in /settings.
LEETCODE_USERNAME=""

# --- Optional: notifications outside the dashboard (cron reminders, "Send test" in /settings) ---
# Telegram: create a bot with @BotFather, message it once, then read chat.id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Recipient for the ~8:00 plan email, the ~20:30 evening nudge, the ~23:59 night recap and the Sunday weekly report
NOTIFY_EMAIL=""
# Email via Brevo free tier (300/day). Used instead of Resend when set. Paste the v3 API key (xkeysib-...)
# or the base64 MCP key. The sender must be verified in Brevo, and API-key IP blocking must be off
# (Brevo > Security > Authorised IPs) because Vercel has no fixed IPs. SMTP is not used.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
# Email via Resend free tier (3,000/month). Without RESEND_FROM_EMAIL it sends from onboarding@resend.dev,
# which only reaches the address you signed up with. Set it to any address on a domain verified in Resend.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
# WhatsApp via Whapi.Cloud (channel token from the Whapi dashboard). WHATSAPP_TO is the recipient with
# country code, digits only (e.g. 919891142251). Messages to the channel's own number land in "Message yourself".
WHAPI_TOKEN=""
WHATSAPP_TO=""
# PWA notifications (Web Push, free). Generate a pair with `npx web-push generate-vapid-keys`, then turn
# them on per device in Settings > App notifications (on iPhone, from the Home Screen app).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact for the push services; defaults to mailto:ADMIN_EMAIL.
VAPID_SUBJECT=""
# Public URL of the app, used for links in emails
APP_URL=""
# Optional Redis (Upstash free tier, REST). Used for sync locks, rate limits, short caches and the live-update
# event log. Leave empty and MongoDB does all of this, so the app needs nothing extra. The free tier counts
# commands, so live updates poll gently (see docs/ARCHITECTURE.md).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Owner id that scopes every user-data row (core/db/owner.ts). Leave blank: "owner". PrepOS has no sign-up.
OWNER_ID=""
# Local stack (docker compose up -d mongo redis redis-rest):
#   MONGODB_URI="mongodb://localhost:27017/prepos?replicaSet=rs0&directConnection=true"
#   UPSTASH_REDIS_REST_URL="http://localhost:8079"   UPSTASH_REDIS_REST_TOKEN="local-dev-token"

# Optional Upstash QStash (free): the outbox relay publishes events to it and it pushes to /api/queue/[topic] with
# signed retries. Needs APP_URL (public https URL). Without these, MongoDB polling (cron /api/cron/relay or `npm run worker`)
# delivers the same events.
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# Optional OpenTelemetry export (Grafana Cloud free tier: Connections > OpenTelemetry). Without an endpoint tracing is off.
# OTEL_EXPORTER_OTLP_ENDPOINT="https://otlp-gateway-prod-<region>.grafana.net/otlp"
# OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic <base64 of instanceId:token>"
# OTEL_SERVICE_NAME="prepos"
# LOG_LEVEL="info"
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_EXPORTER_OTLP_HEADERS=""

# Inbound jobs webhook (POST /api/webhooks/jobs, Authorization: Bearer <this>). 16+ random characters, e.g. `openssl rand -base64 24`.
# Lets n8n, Zapier, Apify or a script push jobs in. Unset = the endpoint answers 503.
JOBS_WEBHOOK_SECRET=""

# Optional: a GitHub token with NO scopes (github.com/settings/tokens) lifts the 60 requests/hour limit when PrepOS reads
# a public repo for the project mock interview. Public repositories only; the token is never logged.
GITHUB_TOKEN=""
