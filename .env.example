# --- Required ---
# MongoDB Atlas M0 connection string (Database > Connect > Drivers)
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/prepos?retryWrites=true&w=majority"

# openssl rand -base64 32
AUTH_SECRET=""

# Your single login. Generate the hash with: npm run hash -- 'your-strong-password'
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD_HASH_B64=""
ADMIN_NAME="Your Name"

# openssl rand -hex 32 (Vercel Cron sends it automatically as a Bearer token)
CRON_SECRET=""

APP_TIMEZONE="Asia/Kolkata"

# --- Optional: LLM for quizzes & summaries (app falls back to data/quiz-bank.json) ---
# gemini | anthropic | openai-compatible
LLM_PROVIDER="gemini"
LLM_API_KEY=""
# e.g. a current Gemini Flash model on the free tier, claude-haiku-4-5-20251001, or a Groq model id
LLM_MODEL=""
# Only for openai-compatible providers, e.g. https://api.groq.com/openai/v1
LLM_BASE_URL=""
# Only used by `npm run quiz-bank -- --llm`: pause between LLM calls (ms) to stay under free-tier rate limits
LLM_DELAY_MS="4000"

# --- Optional: LeetCode sync (public profile, no login) ---
# Seeds the username on first run; afterwards change it in /settings.
LEETCODE_USERNAME=""

# --- Optional: notifications outside the dashboard (cron reminders, "Send test" in /settings) ---
# Telegram: create a bot with @BotFather, message it once, then read chat.id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Email via Resend free tier (sends from onboarding@resend.dev to your own address)
RESEND_API_KEY=""
NOTIFY_EMAIL=""
