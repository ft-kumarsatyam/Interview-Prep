{
  "manifest_version": 3,
  "name": "PrepOS",
  "version": "1.1.0",
  "description": "Ask Gemini from PrepOS, and send the job page or profile you are viewing to PrepOS when you click the toolbar icon.",
  "minimum_chrome_version": "110",
  "permissions": [
    "tabs",
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.vercel.app/*"
      ],
      "js": [
        "content-app.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Send this job or profile page to PrepOS"
  }
}
