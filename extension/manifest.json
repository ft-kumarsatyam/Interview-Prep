{
  "manifest_version": 3,
  "name": "PrepOS: Ask Gemini",
  "version": "1.0.0",
  "description": "Sends the prompt from a PrepOS 'Ask Gemini' button straight into your open Gemini tab.",
  "minimum_chrome_version": "110",
  "permissions": ["tabs", "scripting"],
  "host_permissions": ["https://gemini.google.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://*.vercel.app/*"],
      "js": ["content-app.js"],
      "run_at": "document_start"
    }
  ]
}
